---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Simone Daniotti" current="home"
  description="Simone Daniotti, postdoctoral researcher at the Haas School of Business, UC Berkeley, and Junior Fellow of the Complexity Science Hub Vienna.">
  <section class="hero" aria-labelledby="name">
    <div class="wrap hero__grid">
      <div class="hero__text">
      <h1 class="hero__name" id="name" data-rise>{site.name}</h1>
      <ul class="hero__roles" data-rise style="--d:90ms">
        {site.roles.map((r) => <li>{r}</li>)}
      </ul>
      <p class="hero__fields" data-rise style="--d:140ms">Fields: {site.fields.join(' · ')}</p>
      <ul class="hero__links" aria-label="Profiles" data-rise style="--d:180ms">
        <li><a class="link" href={site.scholarUrl}>Google Scholar</a></li>
        <li><a class="link" href={site.linkedinUrl}>LinkedIn</a></li>
        <li><a class="link" href="cv.pdf" target="_blank" rel="noopener">CV</a></li>
      </ul>
      </div>
      <picture class="ph hero__photo" data-rise style="--d:120ms">
        <source srcset="images/simone-daniotti.webp" type="image/webp">
        <img src="images/simone-daniotti.jpg" width="600" height="750" alt="Portrait of Simone Daniotti" decoding="async" fetchpriority="high">
      </picture>
    </div>
  </section>

  <section class="about" aria-labelledby="about-head">
    <div class="wrap about__grid">
      <h2 class="about__head" id="about-head" data-rise>About</h2>
      <div class="about__body">
        <p data-rise style="--d:80ms">I am a <strong>postdoctoral researcher at the Haas School of Business, UC Berkeley</strong>, and a <strong>Junior Fellow of the Complexity Science Hub Vienna</strong>. I study <strong>AI adoption</strong> and what it means for how firms coordinate work internally and for patterns of innovation. My recent work focuses on how <strong>generative AI is used to write software across countries</strong> and who benefits from it (<a class="link" href="https://doi.org/10.1126/science.adz9311"><em>Science</em>, 2026</a>). During my research stay at the <strong>Harvard Growth Lab</strong>, I also studied how <strong>American cities developed over almost two centuries</strong> (<a class="link" href="https://doi.org/10.1073/pnas.2501504122"><em>PNAS</em>, 2025</a>).</p>
        <p data-rise style="--d:160ms">Previously, I was a researcher at the <strong>Copernicus Institute, Utrecht University</strong>. I hold a <strong>PhD in Computer Science from TU Wien and the Complexity Science Hub</strong> and trained as a <strong>physicist at the University of Milan</strong>. I combine large-scale data with methods from <strong>network science, statistical inference and machine learning</strong>. I work at the intersection of <strong>economics, computational social science and complex systems</strong>, on questions such as how new technologies spread, who gains from them, and how they reshape the way people coordinate.</p>
      </div>
    </div>
  </section>
</Base>
