---
const { current } = Astro.props as { current: string };
const cur = (k: string) => (current === k ? 'page' : undefined);
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="nav__name" data-rise href="index.html" aria-current={cur('home')}>Simone Daniotti</a>
    <nav class="nav__links" aria-label="Main" data-rise style="--d:60ms">
      <a href="publications.html" aria-current={cur('publications')}>Publications</a>
      <a href="teaching.html" aria-current={cur('teaching')}>Teaching</a>
      <a href="cv.pdf" target="_blank" rel="noopener">CV</a>
      <button class="theme-toggle" type="button" aria-label="Switch colour mode">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
